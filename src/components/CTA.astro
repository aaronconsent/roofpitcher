---
interface Props {
  title?: string;
  sub?: string;
  cta?: { href: string; label: string };
}
const {
  title = 'Stop leaving roofs on the table.',
  sub = 'Book a free 15-minute Pitch Audit. We listen to one of your reps, tell you exactly what’s costing you deals, and show you the fix.',
  cta = { href: '/book/', label: 'Book the Pitch Audit' }
} = Astro.props;
---
<section class="border-y-2 border-ink-900 bg-torch-500">
  <div class="container-x grid gap-6 py-14 md:grid-cols-[2fr_1fr] md:items-center">
    <div>
      <span class="eyebrow text-ink-900">Next step</span>
      <h2 class="mt-2 text-4xl md:text-5xl">{title}</h2>
      <p class="mt-3 max-w-2xl text-ink-900/80">{sub}</p>
    </div>
    <a href={cta.href} class="btn-dark justify-self-start md:justify-self-end">{cta.label} →</a>
  </div>
</section>
