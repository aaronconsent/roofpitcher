---
interface Props {
  category: string;
  title: string;
  desc: string;
  href: string;
  free?: boolean;
}
const { category, title, desc, href, free = true } = Astro.props;
---
<a href={href} class="group block border-2 border-ink-900 bg-white p-6 shadow-hard-sm no-underline transition-transform hover:-translate-y-1 hover:shadow-hard">
  <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider">
    <span class="text-torch-600">{category}</span>
    {free && <span class="border border-ink-900 px-2 py-0.5">Free</span>}
  </div>
  <h3 class="mt-3 text-2xl text-ink-900 group-hover:text-torch-700">{title}</h3>
  <p class="mt-2 text-sm text-ink-700">{desc}</p>
  <div class="mt-4 text-sm font-semibold text-ink-900">Open →</div>
</a>
