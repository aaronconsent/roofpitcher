---
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t-2 border-ink-900 bg-ink-900 text-white">
  <div class="stripe h-3"></div>
  <div class="container-x grid gap-10 py-14 md:grid-cols-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="grid h-9 w-9 place-items-center bg-torch-500 text-ink-900 border-2 border-white font-display text-lg">RP</span>
        <span class="font-display text-xl">ROOF PITCHER</span>
      </div>
      <p class="mt-4 text-sm text-ink-300">
        Built for blue-collar roofers who want to stop guessing and start booking. Tyler Mentges + a sales system that scales.
      </p>
    </div>
    <div>
      <h4 class="text-sm">Train</h4>
      <ul class="mt-3 space-y-2 text-sm text-ink-300">
        <li><a href="/services/" class="no-underline hover:text-torch-400">Services</a></li>
        <li><a href="/zero-to-50/" class="no-underline hover:text-torch-400">Zero to 50 Program</a></li>
        <li><a href="/resources/" class="no-underline hover:text-torch-400">Free Resources</a></li>
        <li><a href="/podcast/" class="no-underline hover:text-torch-400">Podcast</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-sm">Trust</h4>
      <ul class="mt-3 space-y-2 text-sm text-ink-300">
        <li><a href="/case-studies/" class="no-underline hover:text-torch-400">Case Studies</a></li>
        <li><a href="/about/" class="no-underline hover:text-torch-400">About Tyler</a></li>
        <li><a href="/partners/aaron-chat/" class="no-underline hover:text-torch-400">Marketing Partner</a></li>
        <li><a href="/blog/" class="no-underline hover:text-torch-400">Field Notes</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-sm">Get Started</h4>
      <p class="mt-3 text-sm text-ink-300">15-minute Pitch Audit. Free. No fluff.</p>
      <a href="/book/" class="btn-primary mt-4">Book a Call →</a>
    </div>
  </div>
  <div class="border-t border-ink-700">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-ink-400 sm:flex-row sm:justify-between">
      <div>© {year} Roof Pitcher. All rights reserved.</div>
      <div>Marketing fulfilled by <a href="https://aaron.chat" class="text-torch-400 no-underline">aaron.chat</a></div>
    </div>
  </div>
</footer>
