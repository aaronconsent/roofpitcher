---
import BaseLayout from '../../layouts/BaseLayout.astro';
import course from '../../../courses/storm-sales-mastery/course.json';
---
<BaseLayout title="Learn — Roof Pitcher" description="The Roof Pitcher learning library. Storm sales, retail, insurance, ops.">
  <section class="border-b-2 border-ink-900 bg-ink-100">
    <div class="container-x py-16">
      <span class="eyebrow">Learning library</span>
      <h1 class="mt-3 text-5xl md:text-6xl">COURSES.<br/><span class="text-torch-600">RUN AT YOUR PACE.</span></h1>
    </div>
  </section>

  <section class="container-x py-16">
    <a href={`/learn/${course.slug}/`} class="block border-2 border-ink-900 shadow-hard bg-white p-8 no-underline hover:-translate-y-1 transition-transform">
      <span class="eyebrow">{course.tier === 'pitch-pack' ? 'Pitch Pack · Included' : course.tier}</span>
      <h2 class="mt-2 text-4xl">{course.title}</h2>
      <p class="mt-3 text-ink-700 text-lg">{course.tagline}</p>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold uppercase tracking-wider text-ink-600">
        <span>{course.lesson_count} lessons</span>
        <span>•</span><span>{course.duration_min} min</span>
        <span>•</span><span>w/ {course.instructor}</span>
      </div>
      <div class="mt-6 text-sm font-bold uppercase tracking-wider text-torch-600">Open course →</div>
    </a>
  </section>
</BaseLayout>
