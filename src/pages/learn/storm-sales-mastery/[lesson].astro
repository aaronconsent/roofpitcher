---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import course from '../../../../courses/storm-sales-mastery/course.json';

export async function getStaticPaths() {
  const paths = [];
  for (const l of course.lessons) {
    try {
      const mod = await import(`../../../../courses/storm-sales-mastery/lessons/${l.id}.json`);
      paths.push({ params: { lesson: l.id }, props: { lesson: mod.default, meta: l } });
    } catch {
      // not yet generated — skip
    }
  }
  return paths;
}

const { lesson, meta } = Astro.props;
const idx = course.lessons.findIndex(l => l.id === meta.id);
const prev = idx > 0 ? course.lessons[idx - 1] : null;
const next = idx < course.lessons.length - 1 ? course.lessons[idx + 1] : null;

// Naive markdown → HTML (good enough for now; replace with @astrojs/markdown-remark if you want full features)
function md(s = '') {
  return s
    .replace(/^### (.*$)/gim, '<h3 class="font-display text-2xl mt-8 mb-3 uppercase">$1</h3>')
    .replace(/^## (.*$)/gim, '<h2 class="font-display text-3xl mt-10 mb-4 uppercase text-torch-600">$1</h2>')
    .replace(/^# (.*$)/gim, '<h1 class="font-display text-4xl mt-10 mb-4 uppercase">$1</h1>')
    .replace(/^> (.*$)/gim, '<blockquote class="border-l-4 border-torch-500 bg-ink-100 pl-4 py-3 my-4 font-mono text-sm">$1</blockquote>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code class="bg-ink-100 px-1.5 py-0.5 text-sm font-mono">$1</code>')
    .split(/\n\n+/).map(p => p.startsWith('<') ? p : `<p class="mt-4 leading-relaxed">${p.replace(/\n/g, '<br/>')}</p>`).join('\n');
}

const audioUrl = `/audio/storm-sales-mastery/${meta.id}.mp3`;
---
<BaseLayout title={`${lesson.title} — Storm Sales Mastery`} description={lesson.summary}>
  <section class="border-b-2 border-ink-900 bg-ink-100">
    <div class="container-x py-10">
      <a href="/learn/storm-sales-mastery/" class="text-sm font-bold uppercase tracking-wider text-ink-600 no-underline hover:text-torch-600">← Storm Sales Mastery</a>
      <div class="mt-3 flex items-baseline gap-3 flex-wrap">
        <span class="eyebrow">Lesson {String(idx + 1).padStart(2,'0')} of {course.lessons.length}</span>
        <span class="text-sm text-ink-600">{lesson.duration_min || meta.duration_min} min</span>
      </div>
      <h1 class="mt-2 text-5xl md:text-6xl">{lesson.title}</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-700">{lesson.summary}</p>
    </div>
  </section>

  <section class="container-x py-10">
    <div class="card bg-ink-900 text-white">
      <span class="eyebrow text-torch-400">▶ Listen on the road</span>
      <audio class="mt-3 w-full" controls preload="none" src={audioUrl}></audio>
      <p class="mt-2 text-xs text-ink-400">If the player is empty, the Audio Overview hasn't been added yet. See PROMPTS.md step 3.</p>
    </div>
  </section>

  <article class="container-x pb-10 prose-roof max-w-3xl">
    <div set:html={md(lesson.body_markdown)}></div>
  </article>

  {lesson.scripts && lesson.scripts.length > 0 && (
    <section class="container-x py-10 max-w-3xl">
      <h2 class="text-3xl">SCRIPTS IN THIS LESSON</h2>
      <div class="mt-5 space-y-5">
        {lesson.scripts.map(s => (
          <div class="card">
            <h3 class="text-2xl">{s.name}</h3>
            <p class="mt-1 text-sm text-ink-600"><span class="eyebrow">When to use</span> · {s.when_to_use}</p>
            <div class="mt-4 border-l-4 border-torch-500 bg-ink-100 p-4 font-mono text-sm space-y-2">
              {s.lines.map(line => <p>{line}</p>)}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="container-x py-10 max-w-3xl">
    <h2 class="text-3xl">KEY TAKEAWAYS</h2>
    <ul class="mt-5 space-y-3">
      {lesson.key_takeaways.map(t => (
        <li class="flex gap-3 border-l-4 border-torch-500 bg-white pl-4 py-2 text-lg">
          <span class="text-torch-600 font-bold">▶</span>{t}
        </li>
      ))}
    </ul>
  </section>

  {lesson.quiz && lesson.quiz.length > 0 && (
    <section class="container-x py-10 max-w-3xl">
      <h2 class="text-3xl">QUICK CHECK</h2>
      <div class="mt-5 space-y-6">
        {lesson.quiz.map((q, qi) => (
          <div class="card">
            <p class="font-bold">{qi + 1}. {q.q}</p>
            <div class="mt-3 space-y-2">
              {q.choices.map((c, ci) => (
                <label class="flex items-center gap-3 border-2 border-ink-200 p-2 hover:border-ink-900 cursor-pointer">
                  <input type="radio" name={`q-${qi}`} value={ci} data-answer={q.answer_index} data-explanation={q.explanation} />
                  <span>{c}</span>
                </label>
              ))}
            </div>
            <div class="quiz-explain mt-3 hidden border-l-4 border-torch-500 bg-ink-100 p-3 text-sm"></div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="container-x py-10 max-w-3xl">
    <div class="card-dark">
      <span class="eyebrow text-torch-400">Homework</span>
      <p class="mt-2 text-xl">{lesson.homework}</p>
    </div>
  </section>

  <section class="container-x py-10 max-w-3xl">
    <div class="flex justify-between gap-4">
      {prev
        ? <a href={`/learn/storm-sales-mastery/${prev.id}/`} class="btn-ghost">← {prev.title}</a>
        : <span></span>}
      {next
        ? <a href={`/learn/storm-sales-mastery/${next.id}/`} class="btn-primary">{next.title} →</a>
        : <a href="/learn/storm-sales-mastery/" class="btn-primary">Back to course →</a>}
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(input => {
      input.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        const correct = String(t.value) === String(t.dataset.answer);
        const card = t.closest('.card');
        const exp = card?.querySelector<HTMLElement>('.quiz-explain');
        if (exp) {
          exp.classList.remove('hidden');
          exp.innerHTML = (correct ? '<strong class="text-torch-600">✓ Correct.</strong> ' : '<strong class="text-red-600">✗ Not quite.</strong> ') + (t.dataset.explanation || '');
        }
      });
    });
  </script>
</BaseLayout>
